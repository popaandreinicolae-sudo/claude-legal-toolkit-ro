{
  "description": "Stratul determinist anti-halucinare si anti-ton-AI al cabinetului. Verifica citarile juridice prin surse primare, semnaleaza sursele-fantoma, prinde erorile de ordin de marime si scoreaza naturaletea textului scris. Hook-urile sunt consultative si fail-open.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/ruleaza.sh\" ensure_deps.py",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/ruleaza.sh\" ai_tone_hook.py",
            "timeout": 25
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/ruleaza.sh\" fact_check_hook.py",
            "timeout": 25
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/ruleaza.sh\" citation_guard.py",
            "timeout": 22
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/ruleaza.sh\" phantom_source_guard.py",
            "timeout": 12
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/ruleaza.sh\" numeric_consistency_guard.py",
            "timeout": 12
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/ruleaza.sh\" prompt_injection_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/ruleaza.sh\" session_end_hook.py",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/ruleaza.sh\" quality_gate_stop_hook.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
